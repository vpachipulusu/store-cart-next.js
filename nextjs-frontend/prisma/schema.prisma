// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model with Firebase Auth
model User {
  id            String    @id @default(cuid())
  firebaseUid   String    @unique
  email         String    @unique
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Profile
  displayName   String?
  bio           String?   @db.Text
  avatarUrl     String?
  location      String?
  website       String?
  phoneNumber   String?

  // Two-Factor Authentication
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?

  // Subscription
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  subscriptionTier       String    @default("free")
  subscriptionStatus     String    @default("inactive")

  // Relations
  settings      UserSettings?
  loginHistory  LoginHistory[]
  notifications Notification[]
  adminUser     AdminUser?

  @@index([email])
  @@index([firebaseUid])
  @@map("users")
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Preferences
  theme              String   @default("system") // "light", "dark", "system"
  emailNotifications Boolean  @default(true)
  language           String   @default("en")
  timezone           String   @default("UTC")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("user_settings")
}

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress   String?
  userAgent   String?
  location    String?
  loginAt     DateTime @default(now())
  successful  Boolean  @default(true)

  @@index([userId, loginAt])
  @@map("login_history")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  link      String?

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model AdminUser {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        String   @default("admin") // "admin", "super_admin"
  permissions Json     // Array of permission strings

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, role])
  @@map("admin_users")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?

  action      String   // e.g., "user.created", "subscription.updated"
  resource    String   // e.g., "User", "Subscription"
  resourceId  String?
  metadata    Json?    // Additional context data
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model SEOMeta {
  id            String   @id @default(cuid())
  page          String   @unique // e.g., "/", "/pricing", "/about"

  title         String
  description   String
  keywords      String?
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  twitterCard   String?  @default("summary_large_image")
  canonical     String?
  noindex       Boolean  @default(false)
  nofollow      Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([page])
  @@map("seo_meta")
}

model URLRedirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301) // 301 or 302
  enabled    Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromPath, enabled])
  @@map("url_redirects")
}

model AppSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String   // e.g., "general", "features", "pricing", "email"
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("app_settings")
}

model FeatureFlag {
  id                String   @id @default(cuid())
  name              String   @unique
  enabled           Boolean  @default(false)
  description       String?
  rolloutPercentage Int      @default(0) // 0-100

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name, enabled])
  @@map("feature_flags")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "welcome", "password-reset"
  subject   String
  htmlBody  String   @db.Text
  textBody  String?  @db.Text
  variables Json?    // Array of variable names used in template

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("email_templates")
}

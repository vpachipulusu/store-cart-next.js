# Fake local-only values for docker-compose.yml. Copy to .env to override the defaults
# (optional: compose works without it). Never put real secrets in this file or in .env.
# Running a second checkout in parallel (KAN-167): give it its own compose project name and host ports.
# COMPOSE_PROJECT_NAME=storecart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=storecart
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5434
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Vercel (KAN-188). Only for the manual preview-deploy workflow (.github/workflows/vercel-preview.yml)
# and local `npm run vercel:*` scripts. Set these as GitHub Actions secrets or in your shell, never here.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Fake local-only values for docker-compose.yml. Copy to .env to override the defaults
# (optional: compose works without it). Never put real secrets in this file or in .env.
# Running a second checkout in parallel (KAN-167): give it its own compose project name and host ports.
# COMPOSE_PROJECT_NAME=storecart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=storecart
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5434
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

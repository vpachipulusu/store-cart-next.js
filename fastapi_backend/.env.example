# Local database (required)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mydatabase

# Optional
# APP_NAME="StoreCart API"
# LOG_LEVEL=INFO

# Deployment environment. Defaults to "production", which makes the Upstash
# settings below mandatory (startup fails without them). Use local for development.
ENVIRONMENT=local

# Redis-backed rate limiting (ADR-007). Optional only when ENVIRONMENT is local or
# test (rate limiting is then disabled). Required everywhere else.
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# OpenAPI generated file output path
OPENAPI_OUTPUT_FILE=../nextjs-frontend/openapi.json

# OPENAPI (Uncomment the line below to disable the /docs and openapi.json urls)
# OPENAPI_URL=""
